{
  "name": "edex-ui",
  "version": "2.2.8",
  "description": "A cross-platform, customizable science fiction terminal emulator with advanced monitoring & touchscreen support.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build",
    "build:linux": "electron-builder build --linux",
    "build:mac": "electron-builder build --mac",
    "build:win": "electron-builder build --win",
    "lint": "eslint src/",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "author": "GitSquared <gabriel@saillard.dev>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/GitSquared/edex-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitSquared/edex-ui.git"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "node-pty": "^0.10.1",
    "systeminformation": "^5.17.12",
    "xterm": "^4.19.0"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "eslint": "^8.30.0"
  },
  "build": {
    "appId": "com.gitSquared.edex-ui",
    "productName": "eDEX-UI",
    "copyright": "Copyright © 2018-2023 GitSquared",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eDEX-UI"
    }
  }
}
